{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/**/__tests__/**"]
}
