// SliceSplit — INR-only expense splitting backend
// All monetary amounts are stored as Int paise (1 INR = 100 paise).
// No multi-currency. No Venmo. No placeholder users (we use Contacts instead).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // `native` for local dev; the linux-musl-openssl-3.0.x targets are for the
  // Alpine container in docker/. Add more here if you deploy to another libc/arch.
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ─────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  name         String
  passwordHash String
  avatarUrl    String?
  upiHandle    String? // for future settle-up via UPI deep link
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     GroupMember[]
  expensesPaid    Expense[]      @relation("ExpensePaidBy")
  expensesCreated Expense[]      @relation("ExpenseCreatedBy")
  expenseShares   ExpenseShare[]
  settlementsOut  Settlement[]   @relation("SettlementFrom")
  settlementsIn   Settlement[]   @relation("SettlementTo")
  contactsOwned   Contact[]      @relation("ContactOwner")
  contactLinked   Contact[]      @relation("ContactLinkedUser")
  refreshTokens   RefreshToken[]
  auditEvents     AuditEvent[]
  receipts        Receipt[]
  guestSplits     GuestSplit[]   @relation("GuestSplitCreatedBy")
  commandRuns     CommandRun[]

  @@index([phone])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── CONTACTS ──────────────────────────────────────────────
// Replaces ShareTab's "placeholder users" pattern. A Contact is something
// a user keeps in their address book — it may or may not be linked to a
// real platform User. Splits can reference Contacts directly for off-platform
// people; once they sign up, the Contact gets linkedUserId set.

model Contact {
  id           String   @id @default(cuid())
  ownerId      String // the user who added this contact
  displayName  String
  phone        String?
  email        String?
  linkedUserId String? // set when this contact matches a real platform User
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkedUser User? @relation("ContactLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@unique([ownerId, phone])
  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([linkedUserId])
}

// ─── GROUPS ────────────────────────────────────────────────

model Group {
  id            String    @id @default(cuid())
  name          String
  emoji         String?   @default("💸")
  description   String?
  simplifyDebts Boolean   @default(true)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invites     GroupInvite[]
  auditEvents AuditEvent[]
  receipts    Receipt[]
  guestSplits GuestSplit[]
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  token     String    @unique @default(cuid())
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// ─── EXPENSES ──────────────────────────────────────────────
// All amounts are paise (Int). 1 INR = 100 paise.

enum SplitMode {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  ITEM // item-level assignment (claimed items + shared portion)
  CONSTRAINT // tag-based: each participant may have allow/deny tag lists
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  title       String
  notes       String?
  amountPaise Int // total amount in paise
  category    String?
  occurredAt  DateTime  @default(now())
  splitMode   SplitMode @default(EQUAL)
  paidById    String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete to preserve audit trail

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  shares    ExpenseShare[]

  @@index([groupId, occurredAt(sort: Desc)])
  @@index([paidById])
}

model ExpenseShare {
  id          String @id @default(cuid())
  expenseId   String
  userId      String
  amountPaise Int // this user's share in paise (always the final settled value)
  shares      Int    @default(1) // raw share units, used in SHARES mode
  basisPoints Int? // 1/100 of a percent, used in PERCENTAGE mode (5000 = 50.00%)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
}

// ─── SETTLEMENTS ───────────────────────────────────────────

model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromId      String
  toId        String
  amountPaise Int
  method      String? // e.g. "UPI", "CASH"; freeform for PR 1
  note        String?
  settledAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  User  @relation("SettlementFrom", fields: [fromId], references: [id])
  to    User  @relation("SettlementTo", fields: [toId], references: [id])

  @@index([groupId, settledAt(sort: Desc)])
  @@index([fromId])
  @@index([toId])
}

// ─── AUDIT ────────────────────────────────────────────────
// Lightweight audit trail. Not an admin dashboard — just an append-only
// log of significant events for debugging and compliance.

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_ARCHIVED
  MEMBER_ADDED
  MEMBER_REMOVED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  INVITE_CREATED
  INVITE_REDEEMED
  RECEIPT_UPLOADED
  RECEIPT_EXTRACTED
  RECEIPT_CONVERTED
  RECEIPT_DUPLICATE
  RECEIPT_RETRIED
  GUEST_SPLIT_CREATED
  GUEST_SPLIT_FINALIZED
  COMMAND_PARSED
  COMMAND_CONFIRMED
  COMMAND_EXECUTED
  COMMAND_REJECTED
  COMMAND_FAILED
}

model AuditEvent {
  id        String      @id @default(cuid())
  actorId   String?
  groupId   String?
  action    AuditAction
  entityId  String? // polymorphic reference
  metadata  Json?
  createdAt DateTime    @default(now())

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([groupId, createdAt])
  @@index([action, createdAt])
}

// ─── RECEIPTS & AI ─────────────────────────────────────────
// A Receipt is an uploaded image that's been processed by an AI provider to
// extract line items. The extraction result is then optionally converted
// into a real Expense (for a group) or a GuestSplit (for no-auth claim flow).

enum ReceiptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Receipt {
  id                   String        @id @default(cuid())
  uploadedById         String
  groupId              String? // null when used for guest-split or unattached
  imagePath            String // path on disk (or s3 key later)
  imageSha256          String // hex digest — drives idempotent dedup
  originalName         String
  mimeType             String
  fileSize             Int
  status               ReceiptStatus @default(PENDING)
  aiProvider           String?
  attemptCount         Int           @default(0)
  isDuplicate          Boolean       @default(false)
  duplicateOfId        String?
  processingStartedAt  DateTime?
  processingFinishedAt DateTime?
  errorReason          String?
  merchantName         String?
  occurredAt           DateTime?
  subtotalPaise        Int?
  taxPaise             Int?
  tipPaise             Int?
  totalPaise           Int?
  rawResponse          Json?
  hint                 String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  uploadedBy  User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items       ReceiptItem[]
  guestSplit  GuestSplit?
  duplicateOf Receipt?      @relation("ReceiptDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Receipt[]     @relation("ReceiptDuplicates")

  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([uploadedById, imageSha256])
  @@index([status])
}

model ReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String
  name       String
  quantity   Int      @default(1)
  unitPaise  Int
  totalPaise Int
  sortOrder  Int      @default(0)
  tags       String[] @default([]) // model-supplied tags: "veg", "non-veg", "alcohol", "dessert", etc.

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// ─── GUEST SPLITS (no-auth shareable bills) ───────────────
// A GuestSplit gives a non-authenticated person a tokenized URL to claim
// items off a receipt. State machine: CLAIMING → FINALIZED.

enum GuestSplitStatus {
  CLAIMING
  FINALIZED
}

model GuestSplit {
  id           String           @id @default(cuid())
  shareToken   String           @unique @default(cuid())
  status       GuestSplitStatus @default(CLAIMING)
  createdById  String
  receiptId    String?          @unique
  groupId      String? // set if eventually attached to a group
  merchantName String?
  totalPaise   Int
  taxPaise     Int?
  tipPaise     Int?
  expiresAt    DateTime?
  finalizedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy User               @relation("GuestSplitCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  receipt   Receipt?           @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  group     Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items     GuestSplitItem[]
  people    GuestSplitPerson[]

  @@index([createdById])
  @@index([shareToken])
  @@index([status])
}

model GuestSplitItem {
  id           String @id @default(cuid())
  guestSplitId String
  name         String
  quantity     Int    @default(1)
  unitPaise    Int
  totalPaise   Int
  sortOrder    Int    @default(0)

  guestSplit  GuestSplit             @relation(fields: [guestSplitId], references: [id], onDelete: Cascade)
  assignments GuestSplitAssignment[]

  @@index([guestSplitId])
}

model GuestSplitPerson {
  id           String   @id @default(cuid())
  guestSplitId String
  name         String
  claimToken   String   @unique @default(cuid())
  upiHandle    String?
  createdAt    DateTime @default(now())

  guestSplit  GuestSplit             @relation(fields: [guestSplitId], references: [id], onDelete: Cascade)
  assignments GuestSplitAssignment[]

  @@unique([guestSplitId, name])
  @@index([guestSplitId])
}

model GuestSplitAssignment {
  id         String @id @default(cuid())
  itemId     String
  personId   String
  shareUnits Int    @default(1)

  item   GuestSplitItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person GuestSplitPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([itemId, personId])
  @@index([itemId])
  @@index([personId])
}

// ─── NL COMMAND LAYER ─────────────────────────────────────
// Every voice or chat utterance is recorded with the full parse + tool-call
// trace + the dry-run plan that was returned to the user. Confirmation flips
// `status` to CONFIRMED; the executor then writes EXECUTED with executionResult.

enum CommandStatus {
  PARSED // intent parsed, plan returned, waiting for confirm
  CONFIRMED // user confirmed, executor running
  EXECUTED // success
  REJECTED // user said no
  FAILED // parse or execution failed
}

model CommandRun {
  id               String        @id @default(cuid())
  userId           String
  source           String // "voice" | "chat"
  status           CommandStatus @default(PARSED)
  utterance        String
  contextGroupId   String?
  contextReceiptId String?
  aiProvider       String?
  parsedIntent     Json?
  toolCallTrace    Json? // [{call, result}] — audit trail of tool-use rounds
  plan             Json? // dry-run plan returned to user
  executionResult  Json? // {expenseId?, groupId?, ...}
  errorReason      String?
  confirmedAt      DateTime?
  executedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}
