# ── HTTP ──
PORT=4000
NODE_ENV=development

# ── Database ──
# Local dev: docker compose up -d postgres
DATABASE_URL="postgresql://slicesplit:slicesplit@localhost:5433/slicesplit?schema=public"

# ── Auth (JWT) ──
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-please-generate-with-openssl-rand-base64-48"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── CORS ──
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──
LOG_LEVEL=info

# ── Rate limiting ──
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ── Uploads ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── AI providers ──
# Comma-separated priority order. First provider whose creds are set wins.
# `mock` is always available as a fallback.
AI_PROVIDER_PRIORITY=bedrock,anthropic,openai,mock

# Anthropic direct (used when ANTHROPIC_API_KEY is set and Bedrock isn't picked first)
# ANTHROPIC_API_KEY=
# CLAUDE_RECEIPT_MODEL=claude-3-5-haiku-20241022
# CLAUDE_INTENT_MODEL=claude-3-5-sonnet-20241022

# AWS Bedrock (Claude on Bedrock). Uses the standard AWS SDK credential chain.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_RECEIPT_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_INTENT_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI (legacy fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
