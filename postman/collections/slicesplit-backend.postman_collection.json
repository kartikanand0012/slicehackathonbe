    {
      "name": "Receipts (async OCR)",
      "description": "AI-powered receipt extraction.\n\n**Flow:**\n1. POST /extract — multipart upload. Returns 202 Accepted with status=PENDING|PROCESSING immediately. SHA-256 dedup: re-uploading the same image within 24h returns 200 with `wasDuplicate=true`.\n2. Poll GET /:id until status flips to COMPLETED or FAILED. Backend retries transient AI errors up to 3x with exponential backoff.\n3. POST /:id/convert — turn extracted items into an Expense. CONSTRAINT splits go through /commands instead.",
      "item": [
        {
          "name": "List my receipts",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/receipts?limit=20", "host": ["{{base_url}}{{api_prefix}}"], "path": ["receipts"], "query": [{ "key": "limit", "value": "20" }, { "key": "groupId", "value": "{{group_id}}", "disabled": true }] } }
        },
        {
          "name": "Upload + extract receipt (async)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 202 || pm.response.code === 200) {",
            "  const body = pm.response.json();",
            "  pm.environment.set('receipt_id', body.receipt.id);",
            "  pm.test('returns wasDuplicate flag', () => pm.expect(body).to.have.property('wasDuplicate'));",
            "  pm.test('initial status is PENDING or PROCESSING or COMPLETED', () =>",
            "    pm.expect(['PENDING','PROCESSING','COMPLETED']).to.include(body.receipt.status));",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "", "description": "Attach a real receipt image" },
                { "key": "groupId", "type": "text", "value": "{{group_id}}" },
                { "key": "hint", "type": "text", "value": "splits among 3 friends" }
              ]
            },
            "url": { "raw": "{{base_url}}{{api_prefix}}/receipts/extract", "host": ["{{base_url}}{{api_prefix}}"], "path": ["receipts", "extract"] }
          }
        },
        {
          "name": "Poll receipt status",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 200) {",
            "  const r = pm.response.json().receipt;",
            "  pm.test('receipt status reported', () => pm.expect(r.status).to.be.a('string'));",
            "  console.log(`status=${r.status} attempts=${r.attemptCount}` + (r.errorReason ? ` err=${r.errorReason}` : ''));",
            "}"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/receipts/{{receipt_id}}", "host": ["{{base_url}}{{api_prefix}}"], "path": ["receipts", "{{receipt_id}}"] } }
        },
        {
          "name": "Stream receipt image (LOCAL backend only — PR 4.5)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}{{api_prefix}}/receipts/{{receipt_id}}/image", "host": ["{{base_url}}{{api_prefix}}"], "path": ["receipts", "{{receipt_id}}", "image"] },
            "description": "Returns the raw image bytes. Only used when `storageBackend` on the receipt is `LOCAL` — S3-backed receipts get a presigned URL pointing directly at S3 in the `imageUrl` field of the receipt response, so the FE never hits this endpoint for those."
          }
        },
        {
          "name": "Convert receipt to expense (EQUAL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Cafe Bistro\",\n  \"paidById\": \"{{user_id}}\",\n  \"splitMode\": \"EQUAL\",\n  \"userIds\": [\"{{user_id}}\", \"REPLACE_WITH_USER_CUID\"]\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/receipts/{{receipt_id}}/convert", "host": ["{{base_url}}{{api_prefix}}"], "path": ["receipts", "{{receipt_id}}", "convert"] }
          }
        }
      ]
    },
    {
      "name": "Commands (NL: voice + chat)",
      "description": "Natural-language command pipeline (proposal §02 'core loop').\n\n**Two-stage flow** — by design rule, every money movement requires explicit confirmation:\n1. POST /commands — model parses the utterance using tool-use (resolve_mention, get_receipt_items, categorize_items, etc.). Returns `{ commandRunId, intent, plan }`.\n2. POST /commands/:id/confirm — executor turns the intent into real writes via existing services.\n3. POST /commands/:id/reject — close as REJECTED.\n\nProvider order is set by AI_PROVIDER_PRIORITY (default: bedrock, anthropic, openai, mock). The mock provider handles 'split this bill ... veg' and 'how much / balance' utterances offline so the demo never blocks.",
      "item": [
        {
          "name": "Parse: dietary CONSTRAINT split (the showstopper)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  pm.environment.set('command_run_id', pm.response.json().commandRun.id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"split this bill between @kartik @sukant @mohit and make sure mohit is veg\",\n  \"source\": \"chat\",\n  \"contextGroupId\": \"{{group_id}}\",\n  \"contextReceiptId\": \"{{receipt_id}}\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Parse: create + populate group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"create a group Rameshwaram, add @sukant @mohit @kartik\",\n  \"source\": \"chat\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Parse: balance query",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"how much does Mohit owe me overall?\",\n  \"source\": \"chat\",\n  \"contextGroupId\": \"{{group_id}}\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Parse: voice transcript (custom ratio)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"split tonight's dinner 50-30-20 with @kartik @sukant @mohit\",\n  \"source\": \"voice\",\n  \"contextGroupId\": \"{{group_id}}\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Parse: settle query",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"remind everyone who hasn't paid in {{group_id}}\",\n  \"source\": \"chat\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Parse: explain my split",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"utterance\": \"why do I owe ₹620?\",\n  \"source\": \"chat\",\n  \"contextGroupId\": \"{{group_id}}\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/commands", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"] }
          }
        },
        {
          "name": "Get command run",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/commands/{{command_run_id}}", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands", "{{command_run_id}}"] } }
        },
        {
          "name": "Confirm command",
          "request": { "method": "POST", "url": { "raw": "{{base_url}}{{api_prefix}}/commands/{{command_run_id}}/confirm", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands", "{{command_run_id}}", "confirm"] } }
        },
        {
          "name": "Reject command",
          "request": { "method": "POST", "url": { "raw": "{{base_url}}{{api_prefix}}/commands/{{command_run_id}}/reject", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands", "{{command_run_id}}", "reject"] } }
        },
        {
          "name": "List recent command runs",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/commands?limit=20", "host": ["{{base_url}}{{api_prefix}}"], "path": ["commands"], "query": [{ "key": "limit", "value": "20" }] } }
        }
      ]
    },
    {
      "name": "Disputes (Fairness Engine)",
      "description": "Proposal §04 — anyone with a share in an expense can flag it. Service first tries to auto-resolve from receipt data + payload; otherwise escalates to the splitter. Resolver posts new share amounts; engine validates sum matches expense total.\n\nState machine: OPEN → AUTO_RESOLVED | RESOLVED | REJECTED.\n\nRate limit: 5 dispute filings per 5 min per IP.\n\nThis folder creates its own fresh expense first (`dispute_expense_id`) so its tests don't depend on the Expenses folder's soft-delete step.",
      "item": [
        {
          "name": "Setup: create fresh expense for dispute tests",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  pm.environment.set('dispute_expense_id', pm.response.json().expense.id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dispute-target dinner\",\n  \"amountPaise\": 250000,\n  \"paidById\": \"{{user_id}}\",\n  \"split\": {\n    \"mode\": \"EXACT\",\n    \"shares\": [\n      { \"userId\": \"{{user_id}}\", \"amountPaise\": 150000 },\n      { \"userId\": \"{{user_b_id}}\", \"amountPaise\": 100000 }\n    ]\n  }\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/groups/{{group_id}}/expenses", "host": ["{{base_url}}{{api_prefix}}"], "path": ["groups", "{{group_id}}", "expenses"] }
          }
        },
        {
          "name": "List disputes on an expense",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/expenses/{{dispute_expense_id}}/disputes", "host": ["{{base_url}}{{api_prefix}}"], "path": ["expenses", "{{dispute_expense_id}}", "disputes"] } }
        },
        {
          "name": "File: small delta → auto-resolved",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  const body = pm.response.json();",
            "  pm.environment.set('dispute_id', body.dispute.id);",
            "  pm.environment.set('dispute_auto_resolved', body.autoResolved ? 'yes' : 'no');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"I think I was charged a few rupees too much for the shared starters\",\n  \"payload\": { \"paiseDelta\": 200 }\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/expenses/{{dispute_expense_id}}/disputes", "host": ["{{base_url}}{{api_prefix}}"], "path": ["expenses", "{{dispute_expense_id}}", "disputes"] }
          }
        },
        {
          "name": "File: large delta → escalates (OPEN)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  pm.environment.set('dispute_open_id', pm.response.json().dispute.id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"I left before dessert was served — please remove ₹500 from my share\",\n  \"payload\": { \"paiseDelta\": 50000 }\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/expenses/{{dispute_expense_id}}/disputes", "host": ["{{base_url}}{{api_prefix}}"], "path": ["expenses", "{{dispute_expense_id}}", "disputes"] }
          }
        },
        {
          "name": "Resolve: splitter posts new shares",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newShares\": [\n    { \"userId\": \"{{user_id}}\", \"amountPaise\": 200000 },\n    { \"userId\": \"{{user_b_id}}\", \"amountPaise\": 50000 }\n  ],\n  \"resolution\": \"Adjusted: removed dessert from your share, redistributed to the splitter.\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/disputes/{{dispute_open_id}}/resolve", "host": ["{{base_url}}{{api_prefix}}"], "path": ["disputes", "{{dispute_open_id}}", "resolve"] }
          }
        },
        {
          "name": "Reject (alternative path — expected 400 since dispute is already RESOLVED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"resolution\": \"After checking the bill, the original split was correct.\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/disputes/{{dispute_open_id}}/reject", "host": ["{{base_url}}{{api_prefix}}"], "path": ["disputes", "{{dispute_open_id}}", "reject"] }
          }
        }
      ]
    },
    {
      "name": "Invites (PR 5 B — WhatsApp/SMS group invites)",
      "description": "Mint short-lived tokens the FE drops into WhatsApp / SMS deep links so a non-Slice contact can land on the redeem page and join the group. Two-faced router: authenticated mutations under /invites, public read under /i/:token.\n\nState machine: PENDING → USED (via /redeem) or EXPIRED (via expiresAt).\n\nRate limit on POST /invites: 10 per 5 min per IP.\n\nThis folder bootstraps its own contact so it can run before the Contacts folder.",
      "item": [
        {
          "name": "Setup: create a Charlie contact for invite flow",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  pm.environment.set('invite_contact_id', pm.response.json().contact.id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Charlie (invite test)\",\n  \"phone\": \"+919812345678\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/contacts", "host": ["{{base_url}}{{api_prefix}}"], "path": ["contacts"] }
          }
        },
        {
          "name": "Mint invite for an existing contact",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  const b = pm.response.json();",
            "  pm.environment.set('invite_token', b.invite.token);",
            "  pm.environment.set('invite_share_url', b.shareUrl);",
            "  pm.test('shareUrl returned', () => pm.expect(b.shareUrl).to.match(/^https?:\\/\\//));",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"groupId\": \"{{group_id}}\",\n  \"contactId\": \"{{invite_contact_id}}\",\n  \"expiresInDays\": 7\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/invites", "host": ["{{base_url}}{{api_prefix}}"], "path": ["invites"] }
          }
        },
        {
          "name": "Mint invite by phone (no Contact pre-existing)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"groupId\": \"{{group_id}}\",\n  \"phone\": \"+919812345678\",\n  \"expiresInDays\": 7\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/invites", "host": ["{{base_url}}{{api_prefix}}"], "path": ["invites"] }
          }
        },
        {
          "name": "Public read by token (no auth — invite landing)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/i/{{invite_token}}", "host": ["{{base_url}}{{api_prefix}}"], "path": ["i", "{{invite_token}}"] },
            "description": "Public endpoint the invite-landing page calls to render group name + expiry + status. No auth, returns nothing PII-y."
          }
        },
        {
          "name": "Redeem invite (auth)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}{{api_prefix}}/invites/{{invite_token}}/redeem", "host": ["{{base_url}}{{api_prefix}}"], "path": ["invites", "{{invite_token}}", "redeem"] },
            "description": "Auth required. Marks invite used, links the underlying Contact to the redeemer's User account (if any), and flips the GroupMember row from contact-kind to user-kind in one transaction. Second call returns 400 INVITE_USED."
          }
        }
      ]
    },
    {
      "name": "Guest Splits (Owner)",
      "description": "Authenticated endpoints — create / list / view your guest splits. The shareToken returned is what the public folder uses.",
      "item": [
        {
          "name": "List my guest splits",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/guest-splits", "host": ["{{base_url}}{{api_prefix}}"], "path": ["guest-splits"] } }
        },
        {
          "name": "Create guest split",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  const g = pm.response.json().guestSplit;",
            "  pm.environment.set('guest_split_id', g.id);",
            "  pm.environment.set('share_token', g.shareToken);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"merchantName\": \"Cafe Bistro\",\n  \"totalPaise\": 97175,\n  \"taxPaise\": 4225,\n  \"tipPaise\": 8450,\n  \"peopleNames\": [\"Alice\", \"Bob\", \"Charlie\"],\n  \"items\": [\n    { \"name\": \"Veg Pizza\", \"quantity\": 1, \"unitPaise\": 45000, \"totalPaise\": 45000 },\n    { \"name\": \"Pasta Arrabbiata\", \"quantity\": 1, \"unitPaise\": 28500, \"totalPaise\": 28500 },\n    { \"name\": \"Iced Latte\", \"quantity\": 2, \"unitPaise\": 5500, \"totalPaise\": 11000 }\n  ]\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/guest-splits", "host": ["{{base_url}}{{api_prefix}}"], "path": ["guest-splits"] }
          }
        },
        {
          "name": "Get owned split (with claim tokens)",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}{{api_prefix}}/guest-splits/{{guest_split_id}}", "host": ["{{base_url}}{{api_prefix}}"], "path": ["guest-splits", "{{guest_split_id}}"] } }
        }
      ]
    },
    {
      "name": "Guest Splits (Public)",
      "description": "No-auth endpoints scoped by shareToken. Anyone with the link can view, add themselves, claim items.",
      "item": [
        {
          "name": "View by share token",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": { "raw": "{{base_url}}{{api_prefix}}/g/{{share_token}}", "host": ["{{base_url}}{{api_prefix}}"], "path": ["g", "{{share_token}}"] } }
        },
        {
          "name": "Add person",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  pm.environment.set('claim_token', pm.response.json().person.claimToken);",
            "}"
          ] } }],
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Diya\",\n  \"upiHandle\": \"diya@okhdfc\"\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/g/{{share_token}}/people", "host": ["{{base_url}}{{api_prefix}}"], "path": ["g", "{{share_token}}", "people"] }
          }
        },
        {
          "name": "Claim items",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"claimToken\": \"{{claim_token}}\",\n  \"itemIds\": [\"REPLACE_WITH_ITEM_CUID\"]\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/g/{{share_token}}/claims", "host": ["{{base_url}}{{api_prefix}}"], "path": ["g", "{{share_token}}", "claims"] }
          }
        },
        {
          "name": "Release items",
          "request": {
            "method": "DELETE", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"claimToken\": \"{{claim_token}}\",\n  \"itemIds\": [\"REPLACE_WITH_ITEM_CUID\"]\n}" },
            "url": { "raw": "{{base_url}}{{api_prefix}}/g/{{share_token}}/claims", "host": ["{{base_url}}{{api_prefix}}"], "path": ["g", "{{share_token}}", "claims"] }
          }
        },
        {
          "name": "Finalize (owner only)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}{{api_prefix}}/g/{{share_token}}/finalize", "host": ["{{base_url}}{{api_prefix}}"], "path": ["g", "{{share_token}}", "finalize"] }
          }
        }
      ]
    }
  ]
}
